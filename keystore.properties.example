# Copy this file to keystore.properties (same folder, project root) and fill in your real values.
# keystore.properties is git-ignored — never commit your actual keystore password.
#
# Don't have a keystore yet? Create one with:
#   keytool -genkeypair -v -keystore quietype-release.keystore -alias quietype -keyalg RSA -keysize 2048 -validity 10000
# Or use Android Studio: Build > Generate Signed Bundle / APK > Create new...
# Play App Signing (recommended, offered during your first Play Console upload) manages the
# final signing key for you — this is just the "upload key" that identifies the build as yours.

storeFile=../quietype-release.keystore
storePassword=
keyAlias=
keyPassword=
